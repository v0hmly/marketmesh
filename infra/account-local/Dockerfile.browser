FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df
ENV CI=true PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
RUN npm install --global pnpm@11.19.0 \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY api/gen/ts/package.json api/gen/ts/package.json
COPY frontend/apps/storefront/package.json frontend/apps/storefront/package.json
RUN pnpm install --frozen-lockfile
RUN apt-get update && apt-get upgrade -y \
    && pnpm --filter @marketmesh/storefront exec playwright install --with-deps chromium \
    && apt-get install -y --no-install-recommends libnss3-tools openssl \
    && rm -rf /var/lib/apt/lists/*
COPY api/gen/ts api/gen/ts
COPY frontend/apps/storefront frontend/apps/storefront
COPY infra/account-local/browser-entrypoint.sh /usr/local/bin/account-browser
RUN chmod 755 /usr/local/bin/account-browser && chown -R node:node /app
USER node
WORKDIR /app/frontend/apps/storefront
ENTRYPOINT ["/usr/local/bin/account-browser"]

{
  "schema_version": "marketmesh.tunnel.slo.scenario/v1",
  "id": "kubernetes-service-outage",
  "kind": "emergency_outage",
  "warm_up": "10s",
  "targets": [
    {"class": "read_idempotent", "min_eligible": 100, "max_error_rate_ppm": 100000, "max_downtime": "15s"},
    {"class": "mutating", "min_eligible": 100, "max_error_rate_ppm": 100000, "max_downtime": "15s"}
  ],
  "faults": [
    {
      "id": "kubernetes-service",
      "target": "kubernetes_service",
      "mode": "service_endpoints_outage",
      "recovery": {"anchor": "fault_started", "max_duration": "15s", "success_streak": 5, "classes": ["read_idempotent", "mutating"]}
    }
  ]
}

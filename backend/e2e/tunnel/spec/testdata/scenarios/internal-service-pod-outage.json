{
  "schema_version": "marketmesh.tunnel.slo.scenario/v1",
  "id": "internal-service-pod-outage",
  "kind": "emergency_outage",
  "warm_up": "10s",
  "targets": [
    {"class": "read_idempotent", "min_eligible": 100, "max_error_rate_ppm": 100000, "max_downtime": "10s"},
    {"class": "mutating", "min_eligible": 100, "max_error_rate_ppm": 100000, "max_downtime": "10s"}
  ],
  "faults": [
    {
      "id": "internal-service-pod",
      "target": "internal_service",
      "mode": "pod_outage",
      "recovery": {"anchor": "fault_started", "max_duration": "10s", "success_streak": 5, "classes": ["read_idempotent", "mutating"]}
    }
  ]
}

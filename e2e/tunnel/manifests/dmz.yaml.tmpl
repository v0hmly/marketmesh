apiVersion: v1
kind: Namespace
metadata:
  name: marketmesh-e2e-tunnel
  labels:
    app.kubernetes.io/managed-by: marketmesh-e2e-tunnel
    marketmesh.io/task: MM-29
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mm29-gateway-in
  namespace: marketmesh-e2e-tunnel
  labels:
    app.kubernetes.io/name: gateway-in
    app.kubernetes.io/part-of: marketmesh-tunnel-e2e
    app.kubernetes.io/managed-by: marketmesh-e2e-tunnel
    marketmesh.io/task: MM-29
    marketmesh.io/dc: {{.DC}}
    marketmesh.io/zone: dmz
    marketmesh.io/run-id: {{.RunID}}
spec:
  replicas: 2
  minReadySeconds: 2
  progressDeadlineSeconds: 120
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: gateway-in
      marketmesh.io/run-id: {{.RunID}}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: gateway-in
        app.kubernetes.io/part-of: marketmesh-tunnel-e2e
        app.kubernetes.io/managed-by: marketmesh-e2e-tunnel
        marketmesh.io/task: MM-29
        marketmesh.io/dc: {{.DC}}
        marketmesh.io/zone: dmz
        marketmesh.io/run-id: {{.RunID}}
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 30
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: gateway-in
          image: {{.GatewayInImage}}
          imagePullPolicy: IfNotPresent
          env:
            - name: SERVICE_VERSION
              value: {{.Version}}
            - name: ENVIRONMENT
              value: e2e-{{.DC}}-dmz
            - name: SERVICE_INSTANCE_ID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: DATA_CENTER
              value: {{.DC}}
            - name: EXPECTED_GATEWAY_OUT_URI
              value: {{.GatewayOutURI}}
            - name: TLS_CERT_FILE
              value: /var/run/marketmesh/tunnel/tls.crt
            - name: TLS_KEY_FILE
              value: /var/run/marketmesh/tunnel/tls.key
            - name: TLS_CLIENT_CA_FILE
              value: /var/run/marketmesh/tunnel/ca.crt
            - name: REQUEST_TIMEOUT
              value: 10s
            - name: TUNNEL_SESSION_TIMEOUT
              value: 30m
            - name: SHUTDOWN_TIMEOUT
              value: 20s
            - name: HEALTH_CHECK_TIMEOUT
              value: 2s
            - name: LOG_LEVEL
              value: info
          ports:
            - name: http
              containerPort: 8080
              protocol: TCP
            - name: tunnel
              containerPort: 8443
              protocol: TCP
          startupProbe:
            httpGet:
              path: /livez
              port: http
            periodSeconds: 1
            timeoutSeconds: 1
            failureThreshold: 30
          readinessProbe:
            httpGet:
              path: /readyz
              port: http
            periodSeconds: 2
            timeoutSeconds: 1
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /livez
              port: http
            periodSeconds: 10
            timeoutSeconds: 1
            failureThreshold: 3
          lifecycle:
            preStop:
              exec:
                command: [/gateway-in, prestop]
          resources:
            requests:
              cpu: 20m
              memory: 32Mi
            limits:
              cpu: 500m
              memory: 192Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
            readOnlyRootFilesystem: true
            runAsNonRoot: true
          volumeMounts:
            - name: tunnel-tls
              mountPath: /var/run/marketmesh/tunnel
              readOnly: true
      volumes:
        - name: tunnel-tls
          secret:
            secretName: mm29-gateway-in-tls
            defaultMode: 0440
---
apiVersion: v1
kind: Service
metadata:
  name: mm29-gateway-in
  namespace: marketmesh-e2e-tunnel
  labels:
    app.kubernetes.io/name: gateway-in
    app.kubernetes.io/part-of: marketmesh-tunnel-e2e
    app.kubernetes.io/managed-by: marketmesh-e2e-tunnel
    marketmesh.io/task: MM-29
    marketmesh.io/dc: {{.DC}}
    marketmesh.io/zone: dmz
    marketmesh.io/run-id: {{.RunID}}
spec:
  publishNotReadyAddresses: true
  type: NodePort
  selector:
    app.kubernetes.io/name: gateway-in
    marketmesh.io/run-id: {{.RunID}}
  ports:
    - name: public-http
      port: 8080
      targetPort: http
      nodePort: 30080
      protocol: TCP
    - name: reverse-tunnel
      port: 8443
      targetPort: tunnel
      nodePort: 30443
      protocol: TCP
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: mm29-gateway-in
  namespace: marketmesh-e2e-tunnel
  labels:
    app.kubernetes.io/name: gateway-in
    app.kubernetes.io/part-of: marketmesh-tunnel-e2e
    app.kubernetes.io/managed-by: marketmesh-e2e-tunnel
    marketmesh.io/task: MM-29
    marketmesh.io/dc: {{.DC}}
    marketmesh.io/zone: dmz
    marketmesh.io/run-id: {{.RunID}}
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: gateway-in
      marketmesh.io/run-id: {{.RunID}}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: mm29-gateway-in
  namespace: marketmesh-e2e-tunnel
  labels:
    app.kubernetes.io/name: gateway-in
    app.kubernetes.io/part-of: marketmesh-tunnel-e2e
    app.kubernetes.io/managed-by: marketmesh-e2e-tunnel
    marketmesh.io/task: MM-29
    marketmesh.io/dc: {{.DC}}
    marketmesh.io/zone: dmz
    marketmesh.io/run-id: {{.RunID}}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: gateway-in
      marketmesh.io/run-id: {{.RunID}}
  policyTypes: [Ingress, Egress]
  ingress:
    - from:
        - ipBlock:
            cidr: 0.0.0.0/0
      ports:
        - port: 8080
          protocol: TCP
        - port: 8443
          protocol: TCP
  egress: []

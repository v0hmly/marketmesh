# Go binaries and test artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/bin/
coverage/
coverage.out
coverage.html
vendor/

# Go workspace state not required by individual modules
go.work.sum

# Node.js dependencies and build artifacts
node_modules/
dist/
.pnpm-store/
*.tsbuildinfo

# Repository-local caches for pinned development tools
.cache/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Temporary files
tmp/
.tmp/

# Graphify artifacts
graphify-out/

# Taskboard transient SQLite files (сама база .taskboard/taskboard.db коммитится)
.taskboard/*.db-shm
.taskboard/*.db-wal

.omo/

# Python infrastructure-tool caches
__pycache__/
*.pyc

# Reproducible generated sources (manifests and generators remain tracked)
/backend/api/gen/go/**/*.pb.go
/backend/api/gen/go/**/*.connect.go
/frontend/gen/**/*_pb.ts
/docs/design/design-system/tokens.css

/frontend/packages/design-system/tokens.css

# Browser reports for every workspace application
/frontend/apps/*/test-results/
/frontend/apps/*/playwright-report/
